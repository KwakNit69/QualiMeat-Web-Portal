rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled == true;
    }

    // A user may create only their own pending profile.
    // They cannot grant themselves admin access.
    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.enabled == false;

      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // Admin portal data: only approved admins may write.
    // Public reads below are kept because the current Vendor Portal reads these
    // collections without Firebase Authentication. Tighten this if you later
    // add Vendor authentication.
    match /inspections/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stalls/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: approved admins only.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
