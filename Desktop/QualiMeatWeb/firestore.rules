rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserProfile()
        && userProfile().role == 'admin'
        && userProfile().enabled == true;
    }

    function isInspector() {
      return hasUserProfile()
        && userProfile().role == 'inspector'
        && userProfile().enabled == true;
    }

    function isStaff() {
      return isAdmin() || isInspector();
    }

    match /users/{uid} {
      // Web admin registration creates pending/disabled users.
      // Mobile inspector registration creates inspector/disabled users.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.enabled == false
        && request.resource.data.role in ['pending', 'inspector'];

      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Users may edit their own profile, but may not change role/enabled.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.enabled == resource.data.enabled);

      allow delete: if isAdmin();
    }

    // PRIVATE: full staff inspection records.
    match /inspections/{inspectionId} {
      allow read, create, update, delete: if isStaff();
    }

    // PRIVATE: full certificate records.
    match /certificates/{certificateId} {
      allow read, create, update, delete: if isStaff();
    }

    // PUBLIC-SAFE: vendor portal may read these without authentication.
    // Staff may write only the approved public schema.
    match /publicInspectionLogs/{inspectionId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'inspectionId',
          'vendorName',
          'stallNumber',
          'inspectorName',
          'scanHistory',
          'resultStatus',
          'certificateStatus',
          'timestamp'
        ]);
      allow delete: if isStaff();
    }

    match /publicCertificates/{certificateId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'certificateId',
          'inspectionId',
          'vendorName',
          'stallNumber',
          'issuedBy',
          'issuedAt',
          'validUntil',
          'status'
        ]);
      allow delete: if isStaff();
    }

    // Stall profiles currently contain only public vendor-display fields.
    // The vendor portal needs unauthenticated read access for QR lookup.
    match /stalls/{stallId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Deny everything else unless explicitly granted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
